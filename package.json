  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "remix": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "^6.0.3"
  }
